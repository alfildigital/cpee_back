APP_NAME="CPEE Gestión"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/cpee

# Configuración de Base de Datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cpee
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Seguridad
SESSION_NAME=CPEE_SECURE_SESSION
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token
