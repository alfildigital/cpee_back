APP_NAME="CPEE Gestión"
APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost/cpee

# Configuración de Base de Datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cpee
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Seguridad
SESSION_NAME=CPEE_SECURE_SESSION
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# API REST (consumida por el frontend)
API_ENABLED=true
API_API_KEY=5d6dd9d5bf47c294b1a49222930870965bc80bd6b442669df701ee695046ba25
